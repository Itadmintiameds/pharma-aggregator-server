          <mxGeometry x="1230" y="240" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Identity note (kept in-service, not shared) -->
        <mxCell id="identitynote" value="Auth stays IN each domain service&#10;(own users/OTP/refresh tokens) --&#10;no shared Auth service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Identity Uniqueness Index (async-fed, no direct buyer<->seller call) -->
        <mxCell id="identityindex" value="Identity Uniqueness Index&#10;(email -&gt; owning_service)&#10;fed by events, queried at signup only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
