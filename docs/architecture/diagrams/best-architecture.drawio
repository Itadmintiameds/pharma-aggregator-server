  <diagram name="Best-Target-Architecture" id="best-arch-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Clients -->
        <mxCell id="client" value="Client Apps&#10;(Web / Mobile / Admin Portal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="680" y="20" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="gateway" value="API Gateway&#10;(Spring Cloud Gateway)&#10;- Auth token validation&#10;- Rate limiting&#10;- Path routing /api/v1/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
