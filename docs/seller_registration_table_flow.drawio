<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="Seller Registration Table Flow" id="sellerRegTableFlow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== STAGE 1 HEADER ===================== -->
        <mxCell id="s1_header" value="Stage 1 — Seller Registration&#10;POST /temp-sellers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s1_1" value="tbl_temp_seller&#10;(main record)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1_2" value="tbl_temp_seller_address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1_3" value="tbl_temp_seller_coordinator&#10;(incl. authorization_letter_url placeholder)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1_4" value="tbl_temp_seller_bank_details&#10;(incl. state/district/taluka)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1_5" value="tbl_temp_seller_document&#10;(1 row per licence + 1 per required agreement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1_6" value="tbl_temp_seller_product_types&#10;(join table, 1 row per product type)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1_7" value="tbl_temp_seller_email_otp&#10;(1 row per OTP send — separate call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s1_note" value="1 transaction → 6 INSERTs (7 incl. OTP)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="300" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== STAGE 2 HEADER ===================== -->
        <mxCell id="s2_header" value="Stage 2 — Document Upload&#10;POST /temp-sellers/{id}/documents/upload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="40" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s2_1" value="UPDATE tbl_temp_seller&#10;(company_registration_certificate_url, gst_document_file_url)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2_2" value="UPDATE tbl_temp_seller_coordinator&#10;(authorization_letter_url)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="440" y="180" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2_3" value="UPDATE tbl_temp_seller_bank_details&#10;(bank_document_file_url)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="440" y="230" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2_4" value="UPDATE tbl_temp_seller_document&#10;(document_file_url — per licence/agreement row, by documentId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s2_note" value="No new tables — UPDATEs only, on rows created in Stage 1" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="320" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== STAGE 3 HEADER ===================== -->
        <mxCell id="s3_header" value="Stage 3 — Admin Approval (ACCEPT)&#10;separate action, not part of self-registration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="40" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="s3_1" value="tbl_seller&#10;(new sellerId generated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="130" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s3_2" value="tbl_seller_address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="175" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s3_3" value="tbl_seller_coordinator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="220" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s3_4" value="tbl_seller_bank_details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="265" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s3_5" value="tbl_seller_gst&#10;(only exists on the permanent side)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="310" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s3_6" value="tbl_seller_document&#10;(mirrored from Stage 1, S3 files re-homed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="355" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s3_7" value="tbl_seller_product_types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s3_8" value="tbl_user&#10;(login credentials created)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="445" width="320" height="35" as="geometry" />
        </mxCell>
        <mxCell id="s3_9" value="tbl_temp_seller_review_history&#10;(audit row: APPROVED/REJECTED/CORRECTION)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="900" y="490" width="320" height="35" as="geometry" />
        </mxCell>

        <mxCell id="s3_note" value="9 new INSERTs on approval" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="535" width="320" height="20" as="geometry" />
        </mxCell>

        <!-- ===================== FLOW ARROWS BETWEEN STAGES ===================== -->
        <mxCell id="arrow_1_2" value="" style="edges=1;html=1;endArrow=block;elbow=vertical;rounded=0;strokeWidth=3;strokeColor=#666666;" edge="1" parent="1" source="s1_header" target="s2_header">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow_2_3" value="" style="edges=1;html=1;endArrow=block;elbow=vertical;rounded=0;strokeWidth=3;strokeColor=#666666;" edge="1" parent="1" source="s2_header" target="s3_header">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== TOTALS SUMMARY BOX ===================== -->
        <mxCell id="totals" value="TOTALS&#10;Self-registration submission only: 6–7 tables&#10;Full lifecycle through approval: 16 tables (7 temp-side + 9 permanent-side)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="440" y="600" width="480" height="70" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
